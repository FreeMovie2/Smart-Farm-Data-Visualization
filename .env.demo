# Demo-focused defaults (fast + predictable)
# Use with: docker compose --env-file .env.demo -f infra/docker/docker-compose.yml up -d --build

# API
API_PORT=4000
DB_HOST=db
DB_PORT=5432
DB_NAME=smart_farm
DB_USER=postgres
DB_PASSWORD=postgres

# Worker (fast alerts for demo)
WORKER_INTERVAL_SEC=15
OFFLINE_AFTER_MIN=1
ALERT_RH_THRESHOLD=85
ALERT_RH_WARN_MIN=1
ALERT_RH_CRIT_MIN=2
ALERT_VPD_MIN=0.35
ALERT_VPD_MAX=1.6
ALERT_VPD_WINDOW_MIN=2
ALERT_SOIL_LOW_THRESHOLD=25
ALERT_SOIL_WINDOW_MIN=2
ALERT_EC_MIN=1.2
ALERT_EC_MAX=3.0
ALERT_PH_MIN=5.5
ALERT_PH_MAX=7.0
ALERT_EC_PH_WINDOW_MIN=2
ALERT_STUCK_WINDOW_MIN=3
ALERT_STUCK_EPSILON=0.001

# Mock generator (dense + deterministic)
MOCK_ENABLED=true
MOCK_INTERVAL_SEC=10
API_BASE_URL=http://api:4000
INGEST_PATH=/v1/ingest
API_HEALTH_PATH=/health
MOCK_FARM_ID=farm-001
MOCK_ZONES=zone-1,zone-1,zone-2,zone-2,zone-3,zone-3
MOCK_DEVICE_IDS=dev-01a,dev-01b,dev-02a,dev-02b,dev-03a,dev-03b
MOCK_DEVICE_KEYS=key1a,key1b,key2a,key2b,key3a,key3b
SCENARIO_PROFILE=demo-alerts

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_FARM_ID=farm-001
