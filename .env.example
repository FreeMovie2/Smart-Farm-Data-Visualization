# API
API_PORT=4000
JWT_SECRET=change-me
DB_HOST=db
# DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_farm
DB_USER=postgres
DB_PASSWORD=postgres

# Worker
WORKER_INTERVAL_SEC=60
OFFLINE_AFTER_MIN=10
ALERT_RH_THRESHOLD=85
ALERT_RH_WARN_MIN=5
ALERT_RH_CRIT_MIN=15
ALERT_VPD_MIN=0.35
ALERT_VPD_MAX=1.6
ALERT_VPD_WINDOW_MIN=10
ALERT_SOIL_LOW_THRESHOLD=25
ALERT_SOIL_WINDOW_MIN=10
ALERT_EC_MIN=1.2
ALERT_EC_MAX=3.0
ALERT_PH_MIN=5.5
ALERT_PH_MAX=7.0
ALERT_EC_PH_WINDOW_MIN=10
ALERT_STUCK_WINDOW_MIN=20
ALERT_STUCK_EPSILON=0.001

# Mock generator
MOCK_ENABLED=true
MOCK_INTERVAL_SEC=60
API_BASE_URL=http://api:4000
INGEST_PATH=/v1/ingest
API_HEALTH_PATH=/health
MOCK_FARM_ID=farm-001
MOCK_ZONES=zone-1,zone-1,zone-2,zone-2,zone-3,zone-3
MOCK_DEVICE_IDS=dev-01a,dev-01b,dev-02a,dev-02b,dev-03a,dev-03b
MOCK_DEVICE_KEYS=key1a,key1b,key2a,key2b,key3a,key3b
SCENARIO_PROFILE=realistic
SEED=12345
